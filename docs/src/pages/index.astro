---
import { BasicLayout } from '../components/landing/Layouts/BasicLayout';
import { TopBar } from '../components/landing/TopBar/TopBar';
import { SectionHeader } from '../components/landing/SectionHeader/SectionHeader';
import { Button } from '../components/landing/Button/Button';
import { SwmSection } from '../components/landing/SwmSection/SwmSection';
import GTMBody from '../components/gtm-body.astro';
import GTMHead from '../components/gtm-head.astro';
import PostHog from '../components/posthog.astro';
import '../styles/index.css';
import commonStyle from '../components/landing/common.module.scss';
import { BASE_PATH } from '../../config';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Lynx Pulsar — a Lynx port of Software Mansion's Pulsar haptics library. This site documents the Lynx port; everything else lives at the official Pulsar docs."
    />
    <title>Lynx Pulsar — a Lynx port of Pulsar</title>
    <link rel="icon" type="image/svg+xml" href={`${BASE_PATH}/logo.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Lynx Pulsar — a Lynx port of Pulsar" />
    <meta
      property="og:description"
      content="A Lynx port of Software Mansion's Pulsar haptics library. Companion docs for the Lynx adapter, build pipeline, and architecture — upstream platforms are unchanged."
    />
    <meta property="og:image" content="https://docs.swmansion.com/pulsar/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Lynx Pulsar — a Lynx port of Pulsar" />
    <meta
      name="twitter:description"
      content="A Lynx port of Software Mansion's Pulsar haptics library. Companion docs for the Lynx adapter, build pipeline, and architecture."
    />
    <meta name="twitter:image" content="https://docs.swmansion.com/pulsar/og.png" />
    <GTMHead />
    <PostHog />
  </head>
  <body>
    <GTMBody />

    <div class={commonStyle.bottomBorder}>
      <BasicLayout>
        <TopBar client:load />
      </BasicLayout>
    </div>

    <BasicLayout className={[commonStyle.centerColumn, commonStyle.spaceTopLarge].join(' ')}>
      <SectionHeader
        title="Lynx Pulsar"
        subtitle="A Lynx port of Software Mansion's Pulsar haptics library. This site documents the port; the canonical SDK docs for iOS, Android, and React Native live at docs.swmansion.com/pulsar."
      />

      <div class="ctaRow">
        <Button
          label="Read the Lynx port docs"
          url={`${BASE_PATH}/lynx/overview/`}
          variant="filled"
        />
        <Button
          label="Upstream Pulsar docs ↗"
          url="https://docs.swmansion.com/pulsar"
          variant="unfilled"
        />
      </div>

      <div class="extensionNote">
        <p>
          <strong>This is an extension, not a replacement.</strong>
          Lynx Pulsar reuses the upstream Pulsar Swift SDK, the 151-preset metadata,
          and the visual identity of <code>PulsarApp/</code>. What's new on this site
          is the ReactLynx adapter, the customized <code>LynxExplorer</code> host,
          and the build pipeline that ships a self-contained <code>.lynx</code> bundle.
          For iOS / Android / React Native APIs, follow the upstream link above.
        </p>
      </div>
    </BasicLayout>

    <SwmSection className={commonStyle.spaceTopLarge} />

    <style>
      .ctaRow {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 24px;
      }
      .extensionNote {
        max-width: 720px;
        margin: 64px auto 0;
        padding: 24px 28px;
        border: 1px solid var(--color-blue-50, rgba(56, 172, 221, 0.4));
        border-radius: 16px;
        background-color: rgba(225, 243, 250, 0.4);
        line-height: 1.6;
      }
      .extensionNote p {
        margin: 0;
        color: var(--color-blue-900, #001a72);
      }
      .extensionNote code {
        background-color: rgba(0, 26, 114, 0.06);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.92em;
      }
      @media (max-width: 480px) {
        .ctaRow { flex-direction: column; align-items: stretch; }
        .extensionNote { margin: 48px 16px 0; }
      }
    </style>
  </body>
</html>
