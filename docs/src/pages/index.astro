---
import { BasicLayout } from '../components/landing/Layouts/BasicLayout';
import { TopBar } from '../components/landing/TopBar/TopBar';
import { TopBanner } from '../components/landing/TopBanner/TopBanner';
import { SectionHeader } from '../components/landing/SectionHeader/SectionHeader';
import { PresetsList } from '../components/landing/PresetsList/PresetsList';
import GTMBody from '../components/gtm-body.astro';
import GTMHead from '../components/gtm-head.astro';
import PostHog from '../components/posthog.astro';
import '../styles/index.css';
import commonStyle from '../components/landing/common.module.scss';
import { BASE_PATH } from '../../config';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Rich, ready-to-use haptic feedback for Lynx apps. 151 hand-crafted presets, pattern composer, and realtime composer — through a Lynx native module."
    />
    <title>Lynx Pulsar — haptics for Lynx apps</title>
    <link rel="icon" type="image/svg+xml" href={`${BASE_PATH}/logo.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Lynx Pulsar — haptics for Lynx apps" />
    <meta
      property="og:description"
      content="A community Lynx port of Pulsar by Software Mansion. 151 presets, pattern composer, realtime composer."
    />
    <meta property="og:image" content={`https://huangxuan.me${BASE_PATH}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Lynx Pulsar — haptics for Lynx apps" />
    <meta
      name="twitter:description"
      content="A community Lynx port of Pulsar by Software Mansion. 151 presets, pattern composer, realtime composer."
    />
    <meta name="twitter:image" content={`https://huangxuan.me${BASE_PATH}/og.png`} />
    <GTMHead />
    <PostHog />
  </head>
  <body>
    <GTMBody />

    <div class={commonStyle.bottomBorder}>
      <BasicLayout>
        <TopBar client:load />
      </BasicLayout>
    </div>

    <TopBanner client:load />

    <BasicLayout className={[commonStyle.centerColumn, commonStyle.spaceTopLarge].join(' ')}>
      <SectionHeader
        title="Get to know Pulsar presets"
        subtitle="Don't spend time creating your own patterns. Use these and bring haptics into your Lynx app with one line."
      />
      <PresetsList client:load />
    </BasicLayout>

    <footer class="siteFooter">
      <p>
        An independent Lynx port of <a href="https://github.com/software-mansion/pulsar" target="_blank" rel="noopener">Pulsar by Software Mansion</a>. Not affiliated. Presets, designs and SDK by the original authors.
      </p>
      <p>
        <a href="https://github.com/Huxpro/pulsar" target="_blank" rel="noopener">github.com/Huxpro/pulsar</a>
        ·
        <a href={`${BASE_PATH}/deck/`} target="_blank" rel="noopener">Port deck ↗</a>
      </p>
    </footer>

    <style>
      .siteFooter {
        margin: 96px auto 48px;
        max-width: 720px;
        padding: 0 16px;
        text-align: center;
        font-size: 0.85em;
        line-height: 1.6;
        color: var(--color-blue-700, #38496b);
      }
      .siteFooter p { margin: 4px 0; }
      .siteFooter a { color: inherit; text-decoration: underline; }
      @media (max-width: 480px) {
        .siteFooter { margin: 64px 16px 32px; }
      }
    </style>
  </body>
</html>
